    "event_type_spec": {
      "ingestion_completed": {
        "required_fields": ["occurred_at", "source_system", "definition_version", "coverage_start", "coverage_end", "freshness_as_of"],
        "optional_fields": ["metadata"],
        "source_systems": ["github_actions", "in_app_scheduler"],
        "meaning": "A source ingestion completed successfully.",
        "metric_effects": ["updates freshness and potentially expands coverage"],
        "eligible_attribution_roles": ["none"],
        "confidence_rules": "confirmed if written by scheduler and verified",
        "dedup_key": "source_system + source_record_id + occurred_at (rounded)",
        "idempotency": "idempotent by dedup_key"
      },
      "order_paid": {
        "required_fields": ["occurred_at", "order_id", "net_revenue_cents", "currency"],
        "optional_fields": ["gross_revenue_cents", "refunded_cents", "customer_id", "product_id"],
        "source_systems": ["woocommerce"],
        "meaning": "Order was paid (canonical paid-date definition).",
        "metric_effects": ["increases orders and revenue"],
        "eligible_attribution_roles": ["conversion"],
        "confidence_rules": "confirmed if paid timestamp present and status eligible",
        "dedup_key": "woocommerce:order_id:paid_date",
        "idempotency": "idempotent by order_id"
      },
      "campaign_started": {
        "required_fields": ["occurred_at", "campaign_id"],
        "optional_fields": ["budget_cents", "currency", "audience_id"],
        "source_systems": ["meta_ads"],
        "meaning": "Campaign transitioned to active.",
        "metric_effects": ["may increase impressions/clicks"],
        "eligible_attribution_roles": ["touch"],
        "confidence_rules": "confirmed if platform status transitions",
        "dedup_key": "platform:campaign_id:started",
        "idempotency": "idempotent"
      }
    }
  },
  "business_event_schema": {
    "required": [
      "event_id",
      "event_type",
      "occurred_at",
      "recorded_at",
      "source_system",
      "source_record_id",
      "source_record_ref",
      "channel",
      "confidence",
      "pii_classification"
    ],
    "nullable": [
      "campaign_id",
      "product_id",
      "artwork_id",
      "customer_id",
      "lead_id",
      "order_id",
      "audience_id",
      "geography",
      "device",
      "cost_cents",
      "gross_revenue_cents",
      "refunded_cents",
      "net_revenue_cents",
      "currency",
      "reach",
      "impressions",
      "clicks",
      "engagements",
      "sessions",
      "leads",
      "orders",
      "utm",
      "attribution_window",
      "attribution_role",
      "confidence_reason",
      "freshness_as_of",
      "coverage_start",
      "coverage_end",
      "completeness",
      "definition_version",
      "metadata"
    ],
    "validation_rules": [
      "occurred_at must be parseable ISO timestamp",
      "recorded_at must be >= occurred_at (except clock skew with justification)",
      "currency required if any *_cents is present",
      "net_revenue_cents must equal gross - refunded when all present",
      "confidence must be one of confidence_scale levels",
      "completeness must be one of: complete|partial|unknown",
      "definition_version required for commerce revenue events"
    ]
  },
  "relationship_model": {
    "relationships": [
      { "from": "Artwork", "to": "Product", "cardinality": "1_to_many", "join": "artwork_id" },
      { "from": "Product", "to": "Edition", "cardinality": "1_to_many", "join": "product_id" },
      { "from": "Product", "to": "Order", "cardinality": "many_to_many", "join": "order_line_items" },
      { "from": "Campaign", "to": "PaidAd", "cardinality": "1_to_many", "join": "campaign_id" },
      { "from": "Campaign", "to": "EmailCampaign", "cardinality": "1_to_many", "join": "campaign_id" },
      { "from": "Campaign", "to": "SocialPost", "cardinality": "1_to_many", "join": "campaign_id" },
      { "from": "Campaign", "to": "Product", "cardinality": "many_to_many", "join": "campaign_product_links" },
      { "from": "MarketingAsset", "to": "PaidAd", "cardinality": "1_to_many", "join": "asset_id" },
      { "from": "MarketingAsset", "to": "SocialPost", "cardinality": "1_to_many", "join": "asset_id" },
      { "from": "Customer", "to": "Order", "cardinality": "1_to_many", "join": "customer_id" },
      { "from": "Customer", "to": "Collector", "cardinality": "0_or_1", "join": "collector_id" },
      { "from": "Lead", "to": "Customer", "cardinality": "0_or_1", "join": "customer_id" },
      { "from": "MediaAppearance", "to": "Product", "cardinality": "many_to_many", "join": "linked_product_ids" },
      { "from": "AttributionTouch", "to": "Order", "cardinality": "many_to_many", "join": "order_id" },
      { "from": "Recommendation", "to": "PreparedAction", "cardinality": "1_to_many", "join": "recommendation_id" },
      { "from": "PreparedAction", "to": "Approval", "cardinality": "1_to_1", "join": "prepared_action_id" },
      { "from": "Approval", "to": "Execution", "cardinality": "1_to_0_or_1", "join": "approval_id" },
      { "from": "Execution", "to": "Outcome", "cardinality": "1_to_1", "join": "execution_id" }
    ]
  },
  "knowledge_model": {
    "structures": {
      "Subject": {
        "required_fields": ["subject_id", "name", "type"],
        "types": ["athlete", "celebrity", "team", "university", "city", "moment"],
        "provenance": ["source", "confidence", "effective_from", "effective_to", "last_updated"],
        "rules": ["no hardcoded assumptions without provenance"],
        "retention": "long-term"
      },
      "BusinessRule": {
        "required_fields": ["rule_id", "statement", "scope"],
        "categories": ["pricing", "inventory", "licensing", "scarcity"],
        "provenance": ["source", "confidence", "effective_dates"],
        "overrides": "recorded",
        "retention": "long-term"
      },
      "LearnedPattern": {
        "required_fields": ["pattern_id", "description", "evidence_refs", "confidence"],
        "provenance": ["model_version", "computed_at", "data_window"],
        "retention": "versioned"
      },
      "Hypothesis": {
        "required_fields": ["hypothesis_id", "statement", "status"],
        "statuses": ["proposed", "testing", "supported", "rejected"],
        "provenance": ["proposed_by", "proposed_at"],
        "retention": "long-term"
      },
      "UserPreference": {
        "required_fields": ["preference_id", "statement"],
        "provenance": ["captured_at"],
        "retention": "long-term"
      },
      "OperationalConstraint": {
        "required_fields": ["constraint_id", "statement", "severity"],
        "provenance": ["source"],
        "retention": "long-term"
      }
    }
  },
  "storage_direction": {
    "recommended_tables": [
      {
        "table": "business_events_v1",
        "strategy": "append-only",
        "primary_key": "event_id",
        "dedup_key": "(source_system, source_record_id, event_type)",
        "indexes": ["occurred_at", "event_type", "campaign_id", "product_id", "order_id", "customer_id"],
        "pii": "store pii_classification + restricted columns"
      },
      {
        "table": "entities_products_v1",
        "strategy": "slowly changing dimension",
        "primary_key": "product_id",
        "indexes": ["source identifiers"],
        "pii": "none"
      },
      {
        "table": "recommendations_v1 / prepared_actions_v1 / approvals_v1 / executions_v1 / outcomes_v1",
        "strategy": "event-sourced with immutable receipts",
        "primary_key": "*_id",
        "indexes": ["created_at", "status"],
        "pii": "restricted where needed"
      },
      {
        "table": "source_records_v1",
        "strategy": "optional raw payload references",
        "primary_key": "source_record_ref",
        "indexes": ["source_system", "source_record_id"],
        "pii": "depends on source"
      }
    ],
    "materialization": [
      "Materialized views for daily metrics per channel",
      "Precomputed driver candidates per range",
      "Do not mix exact Woo revenue with platform-reported revenue in the same aggregate"
    ],
    "retention": ["Keep BusinessEvent long-term", "Bound raw payload retention", "Keep derived summaries regeneratable"],
    "versioning": ["Include definition_version and schema version per event type"],
    "reconciliation_jobs": ["Per-source backfill + dedup", "Parity checks where possible"],
    "no_prod_changes_in_discovery": true
  }
}
