  "attribution_models": {
    "models": [
      {
        "model": "first_touch",
        "when": "Lead-gen contexts and long funnels where initial acquisition matters.",
        "requirements": ["Canonical touch timeline with deduped sessions/touches", "Customer/order linkage"],
        "limitations": ["Over-credits first touch; ignores nurture effects"],
        "language": "attributed (first touch)",
        "double_count_prevention": "One order → at most one first-touch credit"
      },
      {
        "model": "last_touch",
        "when": "Direct-response contexts; short window between click and purchase.",
        "requirements": ["Canonical touch timeline", "Attribution window"],
        "limitations": ["Over-credits closing channel"],
        "language": "attributed (last touch)",
        "double_count_prevention": "One order → at most one last-touch credit"
      },
      {
        "model": "linear",
        "when": "Multi-touch journeys with multiple meaningful touches.",
        "requirements": ["All touches in window", "Touch weighting"],
        "limitations": ["Can dilute key drivers"],
        "language": "assisted (linear)",
        "double_count_prevention": "Order revenue split across touches; total sums to 100%"
      },
      {
        "model": "position_based",
        "when": "Journeys where first and last are most important.",
        "requirements": ["Touch ordering", "Defined weighting scheme"],
        "limitations": ["Heuristic weights"],
        "language": "assisted (position-based)",
        "double_count_prevention": "Fixed weight sum=100%"
      },
      {
        "model": "time_decay",
        "when": "Journeys where recency correlates with conversion.",
        "requirements": ["Touch timestamps", "Decay half-life"],
        "limitations": ["Still correlation"],
        "language": "assisted (time-decay)",
        "double_count_prevention": "Normalized weights"
      },
      {
        "model": "platform_reported",
        "when": "Using Meta/GA4 reported conversions when matchback is not possible.",
        "requirements": ["Platform conversion definitions", "Window"],
        "limitations": ["Modeling/black box; can disagree with Woo"],
        "language": "platform-reported",
        "double_count_prevention": "Never sum platform-reported revenue with Woo exact revenue"
      },
      {
        "model": "direct_response",
        "when": "Strict click→purchase within small window; minimal confounds.",
        "requirements": ["Touch within narrow window", "Stable IDs"],
        "limitations": ["Misses assisted effects"],
        "language": "direct-response",
        "double_count_prevention": "Exclusive assignment per order"
      },
      {
        "model": "assisted",
        "when": "Supporting role identification (awareness/consideration) without claiming causation.",
        "requirements": ["Touch timeline", "Non-exclusive credit"],
        "limitations": ["Not causal"],
        "language": "assisted",
        "double_count_prevention": "Report separately from attributed revenue"
      },
