        "relationships": ["BusinessMetric can be derived from BusinessEvent aggregates"],
        "timestamps": ["measured_at"],
        "provenance": ["definition_version", "coverage_*"],
        "freshness": "measured_at",
        "confidence": "varies",
        "pii_classification": "none",
        "retention": "long-term"
      }
    ]
  },
