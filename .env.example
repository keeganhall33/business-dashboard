# Next.js base URL (optional, used for server-side API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: use local JSON seeds instead of Supabase
# Set to "seed" for offline dev; omit or set to anything else for live data.
DASHBOARD_DATA_SOURCE=seed

# Scheduler auth (optional: secret header + GitHub workflow allowlist)
SCHEDULER_SECRET=dev-secret
SCHEDULER_GITHUB_REPO=keeganhall33/business-dashboard
