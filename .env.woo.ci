## Woo telemetry ingestion (GitHub Actions scheduler)
##
## NOTE:
## - This file is committed and must NOT contain plaintext secrets.
## - Values are 1Password secret references resolved at runtime by `op run --env-file`.
## - This template is intentionally Woo-only (no GA4, no FunnelKit).

# Production Supabase (backend)
NEXT_PUBLIC_SUPABASE_URL=op://OpenClaw/Supabase Production API/supabase_url
SUPABASE_SERVICE_ROLE_KEY=op://OpenClaw/Supabase Production API/legacy service role key

# WooCommerce API
WOOCOMMERCE_STORE_URL=op://OpenClaw/Woocommerce API Credentials/url
WOOCOMMERCE_CONSUMER_KEY=op://OpenClaw/Woocommerce API Credentials/username
WOOCOMMERCE_CONSUMER_SECRET=op://OpenClaw/Woocommerce API Credentials/credential

# Optional config
DASHBOARD_PRIMARY_CURRENCY=USD
